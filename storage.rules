rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================
    // PROFILE PHOTOS AND COVER PHOTOS
    // =========================================================
    match /profilePictures/{userId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }


    // =========================================================
    // POSTS
    // Supports photos and videos uploaded by the owner.
    // =========================================================
    match /posts/{userId}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 500 * 1024 * 1024
        && (
          request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('image/.*')
        );
    }


    // =========================================================
    // VIDEOS
    // =========================================================
    match /videos/{userId}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 500 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }


    // =========================================================
    // STORIES
    // Supports both video and photo stories.
    // =========================================================
    match /stories/{userId}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 500 * 1024 * 1024
        && (
          request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('image/.*')
        );
    }


    // =========================================================
    // MUSIC / SOUND FILES
    // =========================================================
    match /sounds/{userId}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }


    // =========================================================
    // REEL COVERS
    // =========================================================
    match /covers/{userId}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }


    // =========================================================
    // EVERYTHING ELSE IS DENIED
    // =========================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}